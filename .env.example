# What to watch
CINEMA_IDS=96
MOVIE_CODE=ODYSSEY
MOVIE_URL=https://www.eventcinemas.com.au/movie/the-odyssey
DAYS_AHEAD=70
TIMEZONE=Australia/Sydney
POLL_MINUTES=30

# Where to email changes
NOTIFY_TO=you@example.com
NOTIFY_ON_REMOVED=false

# Email — Resend HTTP API is preferred and takes precedence over SMTP if both are set.
RESEND_API_KEY=
# Sender. Leave blank: defaults to onboarding@resend.dev, which needs no domain and can
# mail your Resend signup address — keep NOTIFY_TO equal to that and you're done.
MAIL_FROM_ADDRESS=

# SMTP fallback. Ignored when RESEND_API_KEY is set. Works with any personal mailbox
# (Gmail/iCloud app password), also without a domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Persistence — on Railway point this at a mounted volume
STATE_DIR=./data
