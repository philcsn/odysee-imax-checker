# What to watch
CINEMA_IDS=96
MOVIE_CODE=ODYSSEY
MOVIE_URL=https://www.eventcinemas.com.au/movie/the-odyssey
DAYS_AHEAD=70
TIMEZONE=Australia/Sydney
POLL_MINUTES=30

# Where to email changes
NOTIFY_TO=you@example.com
NOTIFY_ON_REMOVED=false

# Email — Resend HTTP API is preferred and takes precedence over SMTP if both are set.
RESEND_API_KEY=
# Sender. Defaults to onboarding@resend.dev, which can ONLY mail your Resend signup
# address. Verify a domain in Resend to send from your own address to anyone.
MAIL_FROM_ADDRESS=

# SMTP fallback (same vars as atrya-site). Ignored when RESEND_API_KEY is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Persistence — on Railway point this at a mounted volume
STATE_DIR=./data
